# Copy to ".env" (repo root or backend/) for local runs.
# On Hostinger, set these in the Node.js app's Environment Variables instead.

# Email (Gmail app password) for contact/career forms and sales notifications
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECEIVER=

# Admin password for /admin-chatbot.html and the visitors download (long random value)
ADMIN_KEY=

# MongoDB connection string (Atlas: allow Hostinger's server IP in Network Access)
MONGO_URI=

# Must be IDENTICAL here and on Hostinger (long random value)
ENCRYPTION_KEY=

# Signs admin and chat session tokens (long random value)
JWT_SECRET=

# Optional
# PORT=5000
# PUBLIC_SITE_URL=https://www.aguainstruments.com
# DATA_DIR=/home/<user>/visitor-data
# UPLOAD_DIR=/home/<user>/visitor-data/resumes
